# Copy this file to .env and fill in values from:
# https://supabase.com/dashboard → your project → Project Settings → API
#
# VITE_SUPABASE_URL      = Project URL
# VITE_SUPABASE_ANON_KEY = anon / public key
#
# Then run supabase/schema.sql in the SQL Editor.
# Create one owner user: Authentication → Users → Add user
# Disable public sign-ups: Authentication → Providers → Email → disable sign-ups

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

